# ==============================================================================
# PULSEBRIDGE DUO — ENVIRONMENT CONFIGURATION SHOWCASE (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local environment:
# cp .env.example .env
#
# IMPORTANT SECURITY DIRECTIVES:
# - Never commit '.env', '.env.local', or production credentials to version control.
# - All server secrets must reside exclusively in backend environment variables.
# - Frontend client code strictly references non-sensitive 'VITE_' variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=development                # 'development', 'staging', 'production'
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default development uses local SQLite.
# For production PostgreSQL / Supabase, supply the connection string:
# e.g. postgresql+psycopg2://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./pulsebridge.db

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE & VAULT INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# If deploying on Supabase managed PostgreSQL / Storage:
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure secret key for signing session tokens:
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE
JWT_EXPIRATION_HOURS=168               # 7-day token expiration (168 hours)

# ------------------------------------------------------------------------------
# 5. INITIAL SYSTEM ADMINISTRATOR BOOTSTRAP (BACKEND ONLY)
# ------------------------------------------------------------------------------
# Initial admin account provisioned at startup only if no admin exists.
# Public registration is strictly restricted to 'patient' and 'caregiver'.
ADMIN_EMAIL=admin@pulsebridge.health
ADMIN_INITIAL_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
ADMIN_FULL_NAME="PulseBridge System Administrator"

# ------------------------------------------------------------------------------
# 6. AI PROVIDER INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# PulseBridge Duo uses 100% deterministic, offline-capable clinical algorithms by default.
# To enable optional Gemini-powered clinical assistant features:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_PROVIDER=none                       # 'none', 'gemini'

# ------------------------------------------------------------------------------
# 7. TELEGRAM CLINICAL NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional Telegram bot integration for critical arrhythmia alert dispatch:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_DEFAULT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ------------------------------------------------------------------------------
# 8. PLATFORM FEATURE TOGGLES
# ------------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true         # Set to 'false' to disable public registration
APP_MAINTENANCE_MODE=false             # Set to 'true' to display maintenance banner

# ------------------------------------------------------------------------------
# 9. FRONTEND CLIENT CONFIGURATION (PUBLIC)
# ------------------------------------------------------------------------------
# The only variable accessible to the client browser bundle:
VITE_API_BASE_URL=http://localhost:8000/api
