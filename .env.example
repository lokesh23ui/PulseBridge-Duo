# ==============================================================================
# PULSEBRIDGE DUO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local deployment:
# cp .env.example .env
#
# NOTE: Never commit '.env' or any sensitive production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # 'development', 'staging', or 'production'
DEBUG=False
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite is used by default for local development.
# For production PostgreSQL: postgresql+psycopg2://user:password@hostname:5432/pulsebridge
DATABASE_URL=sqlite:///./pulsebridge.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key in terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-byte-hex-string
JWT_EXPIRATION_HOURS=168               # 7 days (168 hours)

# ------------------------------------------------------------------------------
# 4. INITIAL SYSTEM ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
# An initial admin account is provisioned at startup only if no admin exists.
# Public registration never creates admin accounts.
ADMIN_EMAIL=admin@pulsebridge.health
ADMIN_INITIAL_PASSWORD=ChangeMeInProduction2026!
ADMIN_FULL_NAME="PulseBridge System Administrator"

# ------------------------------------------------------------------------------
# 5. TELEGRAM CLINICAL ALERT NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave empty if Telegram dispatch is not used in the local environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. EXTERNAL AI & ANALYTICS INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# By default, PulseBridge Duo uses deterministic, offline-capable clinical algorithms.
# If AI assistance features are enabled, configure your provider API key below:
AI_PROVIDER=none                       # 'none', 'gemini', 'openai'
AI_API_KEY=

# ------------------------------------------------------------------------------
# 7. PLATFORM FEATURE TOGGLES
# ------------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true         # Set to 'false' to disable public registration
APP_MAINTENANCE_MODE=false             # Set to 'true' to display platform maintenance notice
